# Copy to .env and source it, or export the variables in CI.
# Every variable is optional; command-line flags take precedence.

# AWS access. Leave AWS_PROFILE empty to use the default credential chain
# (environment variables, shared config, instance role, OIDC in GitHub Actions).
AWS_PROFILE=
AWS_REGION=us-east-1

# Scan tuning. Defaults match the values in the README configuration table.
COST_SENTINEL_LOOKBACK_DAYS=14
COST_SENTINEL_CPU_THRESHOLD=5
COST_SENTINEL_SNAPSHOT_AGE_DAYS=90
COST_SENTINEL_MONTHS=6
COST_SENTINEL_FORMAT=markdown
COST_SENTINEL_LOG_LEVEL=WARNING

# Only needed by "cost-sentinel comment" (the GitHub Action passes it automatically).
GITHUB_TOKEN=
